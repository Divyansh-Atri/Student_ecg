# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma
OLLAMA_TIMEOUT=120

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/medgemma_agent.db

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
ANONYMIZED_TELEMETRY=False

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/models

# ── API Keys (set at least one admin key before running) ──────────────────────
# Comma-separated for multiple keys per role
API_KEYS_ADMIN=change-me-admin-key
API_KEYS_CLINICIAN=change-me-clinician-key
API_KEYS_READONLY=change-me-readonly-key

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Compliance ────────────────────────────────────────────────────────────────
AUDIT_RETENTION_YEARS=6

# ── LLM Behaviour ─────────────────────────────────────────────────────────────
# If True, system continues on rule-based score alone when Ollama is unavailable
LLM_FALLBACK_ON_TIMEOUT=true
# LLM outputs below this confidence are flagged for human review
LLM_CONFIDENCE_THRESHOLD=0.6

# ── Development mode ──────────────────────────────────────────────────────────
# WARNING: Setting DEV_MODE=true disables API key authentication entirely.
# All requests are treated as 'clinician' role with no audit trail of the caller.
# This exists solely to simplify local testing. NEVER set to true in production.
# TODO (future state): Replace DEV_MODE with a proper auth flow (OAuth2/OIDC or
# short-lived session tokens) before any clinical or staging deployment.
DEV_MODE=false
